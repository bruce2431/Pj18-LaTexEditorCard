{
  "name": "pj18-preview",
  "version": "0.8.4",
  "description": "Pj18 · LaTeX 论文预览 v2（网关 backend 模式：在 pdf/backend/ 下拉起 server.py；多卡片 = PDF 卡 + 编译日志卡，打开哪一篇由宿主广播 file-open 驱动）",
  "backend": {
    "name": "Pj18 LaTeX 后端",
    "cmd": ["runtime/python.exe", "-B", "server.py", "--port", "{port}", "--root", "{projectRoot}", "--no-open", "--auto-restart"],
    "cwd": "pdf/backend",
    "port": 0,
    "idleMinutes": 30,
    "readyPath": "/pdf/index.html"
  },
  "owner": "Pj18-LaTex论文书写",
  "hotReload": true
}
