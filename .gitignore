# 自带编译链（MiKTeX Portable，GB 级）——随后端携带但不进版本控制
pdf/backend/tex/

# 自带 Python 运行时（embeddable，~25MB）——同样随后端携带、不进版本控制
pdf/backend/runtime/

# 运行时日志 / 字节码
pdf/backend/**/__pycache__/

# 网关托管后端自动写的运行日志（路径由宿主固定在预览根，不可配置）
backend.log

# Rust 原生合并器的编译中间产物（源码与 native/bin/ 预编译产物入库）
pdf/backend/native/floria_merge/target/
